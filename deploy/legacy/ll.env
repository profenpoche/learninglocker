# Configuration de la pile legacy (Learning Locker v2). Valeurs de test uniquement.
NODE_ENV=production
SITE_URL=http://localhost:18080
APP_SECRET=legacy-reference-secret-not-for-production-0123456789
API_PORT=8080
API_HOST=api
UI_PORT=3000
MONGODB_PATH=mongodb://mongo:27017/learninglocker_v2
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=LEARNINGLOCKER
QUEUE_PROVIDER=REDIS
QUEUE_NAMESPACE=LEGACY
FS_REPO=local
FS_LOCAL_ENDPOINT=/data
FS_SUBFOLDER=storage
LOG_MIN_LEVEL=info
COLOR_LOGS=false
GOOGLE_ENABLED=
ENABLE_STATEMENT_DELETION=true
RESTRICT_CREATE_ORGANISATION=true
TESTING=true
